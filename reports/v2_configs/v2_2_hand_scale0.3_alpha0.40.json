{
  "dense_block_scale": 0.3,
  "alpha": 0.4,
  "features": [
    "bangla_char_ratio",
    "latin_char_ratio",
    "digit_ratio",
    "punctuation_density",
    "repeated_char_run_max",
    "emoji_count",
    "has_url",
    "has_mention",
    "text_length"
  ],
  "scaler": "StandardScaler fitted on each fold's TRAIN rows only",
  "computed_on": "raw text",

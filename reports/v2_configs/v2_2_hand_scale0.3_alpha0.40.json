    "k": 20
  },
  "validation": "StratifiedGroupKFold(5, shuffle=True, random_state=42)",
  "group_key": "clean_text.lower().strip()",
  "metric": "pooled leak-free OOF Macro F1",
  "baseline_oof_macro_f1": 0.639579,
  "evaluation_note": "scale sweep",
  "per_fold_macro_f1": [
    0.641959,
